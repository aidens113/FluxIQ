{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "files": {
    "includes": [
      "package.json",
      "scripts/docs-reference.mjs",
      "scripts/validate-docs.mjs",
      "apps/web/src/app/api/auth/login/route.ts",
      "apps/web/src/app/api/programs/\\[programId\\]/\\[endpoint\\]/route.ts",
      "apps/web/src/lib/login-attempts.ts",
      "apps/web/src/lib/login-attempts.test.ts",
      "apps/web/src/lib/program-route.ts",
      "apps/web/src/lib/program-route.test.ts",
      "apps/web/src/features/programs/shared-ui.tsx",
      "apps/web/src/features/programs/shared-ui.test.tsx",
      "apps/web/src/features/automation-studio/model/project-artifacts.ts",
      "apps/web/src/features/automation-studio/model/project-artifacts.test.ts",
      "packages/fluxiq/src/programs/_shared/api.ts",
      "packages/fluxiq/src/programs/_shared/storage.ts",
      "packages/fluxiq/src/programs/_shared/storage.test.ts",
      "packages/fluxiq/src/programs/permission-matrix.test.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 160
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["packages/fluxiq/src/programs/_shared/storage.ts"],
      "linter": { "rules": { "suspicious": { "noConfusingVoidType": "off" } } }
    },
    {
      "includes": ["apps/web/src/features/automation-studio/model/project-artifacts.ts"],
      "linter": { "rules": { "suspicious": { "noExplicitAny": "off" } } }
    },
    {
      "includes": ["apps/web/src/features/programs/shared-ui.tsx"],
      "linter": {
        "rules": {
          "a11y": { "noLabelWithoutControl": "off" },
          "suspicious": { "noArrayIndexKey": "off" }
        }
      }
    }
  ]
}
