{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@fluxiq/contracts": ["packages/contracts/src/index.ts"],
      "@fluxiq/contracts/*": ["packages/contracts/src/*.ts"],
      "@fluxiq/ui-components": ["packages/ui-components/src/index.ts"],
      "@fluxiq/ui-components/dom": ["packages/ui-components/src/dom/index.ts"],
      "@fluxiq/ui-components/icons": ["packages/ui-components/src/icons/index.ts"],
      "@fluxiq/ui-components/testing": ["packages/ui-components/src/testing/index.ts"],
      "fluxiq": ["packages/fluxiq/src/index.ts"],
      "fluxiq/automation": ["packages/fluxiq/src/framework/automation-service/public/index.ts"],
      "fluxiq/automation-studio": ["packages/fluxiq/src/programs/automation-studio/index.ts"],
      "fluxiq/automation/candidate-authoring": ["packages/fluxiq/src/runtime/flow-authoring/bootstrap/authoring-result/index.ts"],
      "fluxiq/automation/nodes": ["packages/fluxiq/src/framework/automation-service/nodes/index.ts"],
      "fluxiq/automation-studio/dsl": ["packages/fluxiq/src/flows/authoring/dsl/index.ts"],
      "fluxiq/automation-studio/dsl/generator": ["packages/fluxiq/src/flows/authoring/dsl/generator.ts"],
      "fluxiq/secret-keys": ["packages/fluxiq/src/programs/secret-keys/index.ts"],
      "fluxiq/*": ["packages/fluxiq/src/*/index.ts"]
    }
  }
}
