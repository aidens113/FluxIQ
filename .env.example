# Host project root used by @fluxiq/framework. Defaults to process.cwd().
# FLUXIQ_ROOT=.

# Main runtime/config folder. Defaults to .fluxiq under FLUXIQ_ROOT.
# FLUXIQ_DIR=.fluxiq

# Importer-selected domain. The importer manifest supplies its display name,
# labels, recording contracts, and extensions.
# FLUXIQ_DOMAIN_ID=example

# Importer-authored source roots remain outside .fluxiq.
# FLUXIQ_DOMAIN_PROGRAMS_DIR=domains/example/programs
# FLUXIQ_DOMAIN_INPUTS_DIR=domains/example/inputs
# FLUXIQ_DOMAIN_OUTPUTS_DIR=domains/example/outputs

# Legacy storage overrides remain supported as externally managed paths. They
# prevent automatic v1-to-v2 migration and should usually be left unset.
# FLUXIQ_DATA_DIR=external/data
# FLUXIQ_DATABASES_DIR=external/databases
# FLUXIQ_RECORDINGS_DIR=external/recordings
# FLUXIQ_POLICIES_DIR=external/policies
# FLUXIQ_LOGS_DIR=.fluxiq/logs
# FLUXIQ_TEMP_DIR=.fluxiq/tmp

# Optional WebSocket-capable client gateway used by Automation Studio. The web
# app starts this listener from Next server instrumentation in dev/Node hosts.
# FLUXIQ_CLIENT_GATEWAY_ENABLED=true
# FLUXIQ_CLIENT_GATEWAY_HOST=127.0.0.1
# FLUXIQ_CLIENT_GATEWAY_PORT=4777
# FLUXIQ_CLIENT_GATEWAY_PATH=/client
# Trusted-client credentials expire after 30 days by default (milliseconds).
# FLUXIQ_CLIENT_GATEWAY_TRUST_TTL_MS=2592000000
# FLUXIQ_PUBLIC_CLIENT_WS_URL=ws://127.0.0.1:4777/client
# FLUXIQ_CLIENT_GATEWAY_ALLOWED_ORIGINS=chrome-extension://your-extension-id,moz-extension://your-extension-id
