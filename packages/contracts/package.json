{
  "name": "@fluxiq/contracts",
  "version": "0.4.0",
  "description": "Browser-safe shared contracts for FluxIQ programs, clients, and recording integrations.",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=22" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./core": { "types": "./dist/core.d.ts", "import": "./dist/core.js" },
    "./client-gateway": { "types": "./dist/client-gateway.d.ts", "import": "./dist/client-gateway.js" },
    "./program-api": { "types": "./dist/program-api.d.ts", "import": "./dist/program-api.js" },
    "./automation-studio": { "types": "./dist/automation-studio.d.ts", "import": "./dist/automation-studio.js" },
    "./iam": { "types": "./dist/iam.d.ts", "import": "./dist/iam.js" },
    "./platform": { "types": "./dist/platform.d.ts", "import": "./dist/platform.js" }
  },
  "files": ["dist", "README.md", "LICENSE.md"],
  "scripts": {
    "build": "node ../../scripts/build-cache/cli.mjs contracts:build -- \"node --max-old-space-size=4096 node_modules/typescript/bin/tsc -b tsconfig.build.json --clean && node --max-old-space-size=4096 node_modules/typescript/bin/tsc -b tsconfig.build.json && node ../../scripts/rewrite-declaration-imports.mjs dist\"",
    "check": "node ../../scripts/build-cache/cli.mjs contracts:check -- \"node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/fluxiq-build/check.tsbuildinfo\"",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": { "zod": "^3.24.0" },
  "devDependencies": { "typescript": "^5.7.0", "vitest": "^2.1.0" },
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/aidens113/FluxIQ.git", "directory": "packages/contracts" },
  "homepage": "https://getfluxiq.com",
  "bugs": { "url": "https://github.com/aidens113/FluxIQ/issues" }
}
