[
  {
    "name": "complete",
    "description": "Finishes the task with its result.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "description": "Original constraints: minLength: 1; maxLength: 240."
        },
        "result": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "description": "One sentence on what you got."
            },
            "answer": {
              "type": "string",
              "description": "The answer in words, only when the result is words rather than rows or acts."
            },
            "notes": {
              "type": "object",
              "description": "Short plain notes for the next attempt at this same task. Hold no secrets: no passwords, keys or codes.",
              "properties": {
                "worked": {
                  "type": "string",
                  "description": "What worked on this site."
                },
                "failed": {
                  "type": "string",
                  "description": "What did not work."
                },
                "quirks": {
                  "type": "string",
                  "description": "Anything odd about the site worth knowing next time."
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "summary"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "summary",
        "result"
      ]
    },
    "strict": true
  },
  {
    "name": "amend_draft",
    "description": "Changes the Flow draft by the amendments given.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "amendments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step",
              "change"
            ],
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 1,
                "description": "The step number shown in the draft. Every number in one decision names the step as the draft shows it; the draft is renumbered once, after the whole decision."
              },
              "change": {
                "enum": [
                  "keep",
                  "drop",
                  "result",
                  "repeat",
                  "unrepeat",
                  "bind",
                  "rerun"
                ],
                "description": "keep: put back a step the framework left out (its out line says why). drop: take a step out of the Flow. result: this read holds the answer. repeat: do this step again for each row the step given by over produced, or while the step given by while keeps succeeding; a step over, while or through names that was left out comes in. unrepeat: take the repeat off this step. bind: make a value general: input names the parameters to lift, only parameters the step already has -- a value a step typed, or a read's condition; a press's control or option is never bound -- each set to {\"$input\": <name>, \"test\": <value>} for a value the person gave that differs from run to run, or {\"$row\": <field>} for a field of the row a repeat is on. rerun: do this step again in its place, with input as the corrected argument; the new run takes its place, and running the Flow from it checks what follows."
              },
              "input": {
                "type": "object",
                "description": "bind: the parameters to lift -- a value a step typed, or a read's condition; a press's control or option is never bound -- each set to a binding form, at any depth. rerun: a JSON merge patch over the argument the step ran with. Only the keys that change, and a node's parameters may be written without parameters around them; a list replaces whole; null removes a key; a key left out is kept, except in an object you write out again, repeating more of it than you leave out: that drops the keys you were shown and left out, and keeps keys withheld from you; a new key given a left-out key's value renames it."
              },
              "through": {
                "type": "integer",
                "minimum": 1,
                "description": "repeat only: the last step of the span that repeats. Leave it out to repeat this step alone."
              },
              "over": {
                "type": "integer",
                "minimum": 1,
                "description": "repeat only: the step whose rows the span repeats for, a step before this one. Leave it out for the step before it."
              },
              "while": {
                "type": "integer",
                "minimum": 1,
                "description": "repeat only, never with over: the span's last step, which must answer ended when there is nothing more."
              },
              "most": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000,
                "description": "repeat only, and only when the instruction itself gives a number: that many passes or rows at most."
              },
              "act": {
                "type": "string",
                "pattern": "^a[1-9][0-9]{0,2}([.][a-z]{1,16})?$",
                "description": "keep only: the act from the acts checklist this step does. Only a step that changes something does an act."
              },
              "place": {
                "type": "string",
                "pattern": "^(none|r[1-9][0-9]?(,r[1-9][0-9]?){0,19})$",
                "description": "keep only, once the draft shows route: the places on the route this step is on, by their ids."
              }
            }
          }
        }
      },
      "required": [
        "summary",
        "amendments"
      ]
    }
  },
  {
    "name": "web_detect_repeating_structure",
