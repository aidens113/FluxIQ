  {
    "name": "core_run_node",
    "description": "Calls the offered tool core.run_node (evidenceLoop.tools describes it); its input goes in input.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "callId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:-]{1,200}$"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node",
            "parameters",
            "consequences"
          ],
          "properties": {
            "node": {
              "enum": [
                "web.output.browser-download",
                "web.output.browser-navigate",
                "web.output.browser-tab",
                "web.output.dom-assert",
                "web.output.dom-check",
                "web.output.dom-clear",
                "web.output.dom-click",
                "web.output.dom-dialog",
                "web.output.dom-extract",
                "web.output.dom-extract_list",
                "web.output.dom-hover",
                "web.output.dom-keypress",
                "web.output.dom-next_page",
                "web.output.dom-scroll",
                "web.output.dom-select",
                "web.output.dom-type",
                "web.output.dom-upload",
                "web.output.dom-wait_for_selector",
                "web.output.dom-wait_for_text"
              ],
              "description": "The node's id, copied exactly from the catalog."
            },
            "parameters": {
              "type": "object",
              "description": "That node's own parameters, exactly as its definition under describedNodes declares them. Where a value changes between runs or rows, a written step (write true) holds a binding in its place: {\"$input\": \"<name>\", \"test\": <the value to test with>} for a value the person gave, which becomes an input of the Flow, or {\"$row\": \"<field>\"} for a field of the row a repeat is on, or {\"$step\": <n>, \"output\": \"<output id>\"} for an output of the earlier step n (add \"path\": \"<field>\" for one field of a record output). A call that runs now takes concrete values only."
            },
            "consequences": {
              "type": "array",
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "move_money",
                  "delete",
                  "send_or_publish",
                  "modify_existing",
                  "create_new"
                ]
              },
              "description": "What running this node would lastingly do. [] leaves nothing behind; a press that submits, orders, deletes or changes something saved names its class, such as send_or_publish, and is put to the person first."
            },
            "write": {
              "type": "boolean",
              "description": "true: write this step into the Flow without running it -- nothing is done now; it is checked as a run would check it, frozen as written and added, and the test runs it. Use it once what you have seen is enough to know the node and its parameters, and prefer write for a lasting act on items a loop selects: the test acts on exactly the items the Flow selects, and the build changes nothing the Flow should not. Declare consequences as for a run."
            }
          }
        },
        "add": {
          "type": "boolean",
          "description": "Not needed: a step that works joins the Flow by itself, and amend_draft edits what was drafted."
        },
        "act": {
          "type": "string",
          "pattern": "^a[1-9][0-9]{0,2}([.][a-z]{1,16})?$",
          "description": "The act from the acts checklist this step does, such as a2, or the choice under it this step makes, such as a2.quantity."
        },
        "place": {
          "type": "string",
          "pattern": "^(none|r[1-9][0-9]?(,r[1-9][0-9]?){0,19})$",
          "description": "Once the draft shows route: the places on it this step is on, such as r1, or r1,r2 for two; none clears them."
        }
      },
      "required": [
        "summary",
        "callId",
        "input"
      ]
    }
  },
