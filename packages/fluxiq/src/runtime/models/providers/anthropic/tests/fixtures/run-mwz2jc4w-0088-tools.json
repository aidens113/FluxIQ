  {
    "name": "core_check_answer",
    "description": "The answer of the check of an attempt's result, and only that: called once by the check, when a system message asks it to judge, with its verdict, the JSON object its outputSchema asks for, as the whole input. It is never a decision: called while deciding, it is refused and does nothing.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "diagnosis",
        "summary"
      ],
      "properties": {
        "kind": {
          "const": "diagnosis"
        },
        "diagnosis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "expected": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "observed": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "changed": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "stillAchievable": {
              "enum": [
                "yes",
                "no",
                "unknown"
              ]
            },
            "deterministicRecoveryPossible": {
              "enum": [
                "yes",
                "no",
                "unknown"
              ]
            },
            "answersRequest": {
              "enum": [
                "yes",
                "no",
                "unknown"
              ]
            },
            "defects": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "row",
                  "requestWords"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "kept_not_asked",
                      "asked_missing",
                      "wrong_value",
                      "act_missing",
                      "act_wrong",
                      "other"
                    ]
                  },
                  "row": {
                    "type": "string",
                    "minLength": 1
                  },
                  "column": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  },
                  "step": {
                    "type": "string",
                    "minLength": 1
                  },
                  "requestWords": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "checked": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "row",
                  "column",
                  "value"
                ],
                "properties": {
                  "row": {
                    "type": "string",
                    "minLength": 1
                  },
                  "column": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "answerRecords": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "asked"
              ],
              "properties": {
                "asked": {
                  "type": "boolean"
                },
                "siteShows": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "explorationNeeded": {
              "type": "boolean"
            },
            "patchNeeded": {
              "type": "boolean"
            }
          },
          "required": [
            "answersRequest",
            "defects",
            "checked",
            "answerRecords"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "type": "object"
        }
      }
    }
  }
]