[
  {
    "name": "complete",
    "description": "Finishes the task with its result.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "description": "Original constraints: minLength: 1; maxLength: 240."
        },
        "result": {
          "type": "object",
          "description": "Either the complete object of the latest assembly -- exactly revision and digest -- or an honest ending -- exactly ended and reason. A result naming a revision and digest is read as completing on that revision, whatever else it carries.",
          "properties": {
            "revision": {
              "type": "integer"
            },
            "digest": {
              "type": "string"
            },
            "ended": {
              "type": "string",
              "enum": [
                "blocked",
                "partial"
              ]
            },
            "reason": {
              "type": "string",
              "description": "Read by the person as it is: plain words about what could not be done and why, with no codes, tool or subflow names, or build terms."
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "summary",
        "result"
      ]
    },
    "strict": true
  },
