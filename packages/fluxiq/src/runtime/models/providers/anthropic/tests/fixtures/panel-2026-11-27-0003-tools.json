  {
    "name": "core_check_answer",
    "description": "The answer of the check of an attempt's result, and only that: called once by the check, when a system message asks it to judge, with its verdict, the JSON object its outputSchema asks for, as the whole input. It is never a decision: called while deciding, it is refused and does nothing.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "diagnosis",
        "summary"
      ],
      "properties": {
        "kind": {
          "const": "diagnosis"
        },
        "diagnosis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "expected": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "observed": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "changed": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "stillAchievable": {
              "enum": [
                "yes",
                "no",
                "unknown"
              ]
            },
            "deterministicRecoveryPossible": {
              "enum": [
                "yes",
                "no",
                "unknown"
              ]
            },
            "answersRequest": {
              "enum": [
                "yes",
                "no",
                "unknown"
              ]
            },
            "defects": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "row",
