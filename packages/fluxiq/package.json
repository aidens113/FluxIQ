{
  "name": "fluxiq",
  "version": "0.1.0",
  "description": "Domain-neutral FluxIQ framework runtime for Node.js.",
  "type": "module",
  "engines": { "node": ">=22" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./api-contracts": { "types": "./dist/api-contracts/index.d.ts", "import": "./dist/api-contracts/index.js" },
    "./auth": { "types": "./dist/programs/identity-access/index.d.ts", "import": "./dist/programs/identity-access/index.js" },
    "./client-gateway": { "types": "./dist/client-gateway/index.d.ts", "import": "./dist/client-gateway/index.js" },
    "./automation-studio": { "types": "./dist/programs/automation-studio/index.d.ts", "import": "./dist/programs/automation-studio/index.js" },
    "./automation-studio/nodes": { "types": "./dist/programs/automation-studio/nodes/index.d.ts", "import": "./dist/programs/automation-studio/nodes/index.js" },
    "./background-tasks": { "types": "./dist/programs/background-tasks/index.d.ts", "import": "./dist/programs/background-tasks/index.js" },
    "./components": { "types": "./dist/components/index.d.ts", "import": "./dist/components/index.js" },
    "./compute": { "types": "./dist/programs/compute-control/index.d.ts", "import": "./dist/programs/compute-control/index.js" },
    "./compute-control": { "types": "./dist/programs/compute-control/index.d.ts", "import": "./dist/programs/compute-control/index.js" },
    "./core": { "types": "./dist/core/index.d.ts", "import": "./dist/core/index.js" },
    "./data": { "types": "./dist/programs/database-manager/index.d.ts", "import": "./dist/programs/database-manager/index.js" },
    "./database-manager": { "types": "./dist/programs/database-manager/index.d.ts", "import": "./dist/programs/database-manager/index.js" },
    "./deployment-sync": { "types": "./dist/programs/deployment-sync/index.d.ts", "import": "./dist/programs/deployment-sync/index.js" },
    "./domains": { "types": "./dist/domains/index.d.ts", "import": "./dist/domains/index.js" },
    "./docs": { "types": "./dist/programs/docs/index.d.ts", "import": "./dist/programs/docs/index.js" },
    "./engine": { "types": "./dist/engine/index.d.ts", "import": "./dist/engine/index.js" },
    "./flows": { "types": "./dist/flows/index.d.ts", "import": "./dist/flows/index.js" },
    "./framework": { "types": "./dist/framework/index.d.ts", "import": "./dist/framework/index.js" },
    "./identity-access": { "types": "./dist/programs/identity-access/index.d.ts", "import": "./dist/programs/identity-access/index.js" },
    "./io": { "types": "./dist/io/index.d.ts", "import": "./dist/io/index.js" },
    "./production-runner": { "types": "./dist/programs/production-runner/index.d.ts", "import": "./dist/programs/production-runner/index.js" },
    "./programs": { "types": "./dist/programs/index.d.ts", "import": "./dist/programs/index.js" },
    "./ui": { "types": "./dist/ui/index.d.ts", "import": "./dist/ui/index.js" }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -b tsconfig.build.json --clean && tsc -b tsconfig.build.json && node ../../scripts/rewrite-declaration-imports.mjs dist",
    "check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fluxiq/contracts": "workspace:*",
    "qrcode": "^1.5.4",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "typedoc": "^0.28.20",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "typedoc": "^0.28.20"
  },
  "peerDependenciesMeta": {
    "typedoc": {
      "optional": true
    }
  },
  "repository": { "type": "git", "url": "git+https://github.com/aidens113/FluxIQ.git", "directory": "packages/fluxiq" },
  "homepage": "https://github.com/aidens113/FluxIQ#readme",
  "bugs": { "url": "https://github.com/aidens113/FluxIQ/issues" },
  "publishConfig": { "access": "public" }
}
