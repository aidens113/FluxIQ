{
  "name": "@fluxiq/ui-components",
  "version": "0.5.0",
  "description": "FluxIQ's chat UI as plain DOM and CSS, for any client to mount through ports.",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "sideEffects": ["*.css"],
  "engines": { "node": ">=22" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./dom": { "types": "./dist/dom/index.d.ts", "import": "./dist/dom/index.js" },
    "./icons": { "types": "./dist/icons/index.d.ts", "import": "./dist/icons/index.js" },
    "./testing": { "types": "./dist/testing/index.d.ts", "import": "./dist/testing/index.js" },
    "./styles/tokens.css": "./src/theme/tokens.css",
    "./styles/chat.css": "./src/chat/chat.css"
  },
  "files": ["dist", "src/theme/tokens.css", "src/chat/chat.css", "README.md", "LICENSE.md"],
  "scripts": {
    "build": "node ../../scripts/build-cache/cli.mjs ui-components:build -- \"node --max-old-space-size=4096 node_modules/typescript/bin/tsc -b tsconfig.build.json --clean && node --max-old-space-size=4096 node_modules/typescript/bin/tsc -b tsconfig.build.json && node ../../scripts/rewrite-declaration-imports.mjs dist\"",
    "check": "node ../../scripts/build-cache/cli.mjs ui-components:check -- \"node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/fluxiq-build/check.tsbuildinfo\"",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "fluxiq": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "repository": { "type": "git", "url": "git+https://github.com/aidens113/FluxIQ.git", "directory": "packages/ui-components" },
  "homepage": "https://getfluxiq.com",
  "bugs": { "url": "https://github.com/aidens113/FluxIQ/issues" },
  "publishConfig": { "access": "public" }
}
