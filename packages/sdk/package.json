{
  "name": "@fluxiq/sdk",
  "version": "0.4.0",
  "description": "Thin TypeScript client of the FluxNode HTTP API: define a FluxNode, run it, get typed outputs.",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=22" },
  "bin": { "fluxiq": "./dist/cli/bin.js" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "README.md", "LICENSE.md"],
  "scripts": {
    "build": "node ../../scripts/build-cache/cli.mjs sdk:build -- \"node --max-old-space-size=4096 node_modules/typescript/bin/tsc -b tsconfig.build.json --clean && node --max-old-space-size=4096 node_modules/typescript/bin/tsc -b tsconfig.build.json && node ../../scripts/rewrite-declaration-imports.mjs dist\"",
    "check": "node ../../scripts/build-cache/cli.mjs sdk:check -- \"node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/fluxiq-build/check.tsbuildinfo\"",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fluxiq/contracts": "workspace:*",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "repository": { "type": "git", "url": "git+https://github.com/aidens113/FluxIQ.git", "directory": "packages/sdk" },
  "homepage": "https://getfluxiq.com",
  "bugs": { "url": "https://github.com/aidens113/FluxIQ/issues" },
  "publishConfig": { "access": "public" }
}
