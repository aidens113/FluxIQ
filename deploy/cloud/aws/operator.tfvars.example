name              = "fluxiq-platform"
region            = "us-west-2"
availability_zone = "us-west-2a"
ubuntu_ami_id     = "ami-REPLACE_WITH_PINNED_UBUNTU_2404_AMD64_ID"
instance_type     = "m7i.large" # Illustrative only: choose capacity and check availability/pricing.
data_size_gb      = 40
config_secret_arn = "arn:aws:secretsmanager:us-west-2:123456789012:secret:fluxiq-runtime-REPLACE"
release = {
  url    = "https://releases.example.org/fluxiq/core-release.tar.gz"
  sha256 = "REPLACE_WITH_VERIFIED_ARCHIVE_SHA256"
}
