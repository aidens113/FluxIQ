# FluxIQ Core, service profile (a multi-user service with a sign-up site in
# front of it): the operator's settings.
#
# Copy to deploy/env/service.env (git ignores it) and replace every value.
# This file holds no secret: the provisioning token and the setup code are
# files under deploy/secrets/ (docs/operations/self-hosting.md, "Secrets").
# Every value below is a placeholder on a reserved example domain. The
# gateway's <...> entries are refused by the client gateway, so the server
# does not become ready until they are replaced.
#
# deploy/compose/service.compose.yml fixes FLUXIQ_PROFILE=service,
# FLUXIQ_ROOT=/data, FLUXIQ_TRUST_PROXY=true and the provisioning listener's
# address, source ranges and token file itself.

# --- Required ------------------------------------------------------------

# The panel's public origin: https is required on this profile, no path.
FLUXIQ_PUBLIC_ORIGIN=https://app.example.org

# The same host name, for Caddy's site address and certificate.
FLUXIQ_SITE_ADDRESS=app.example.org

# Where the certificate authority sends expiry notices.
ACME_EMAIL=operator@example.org

# The browser-extension origins the gateway admits (see
# self-hosted.env.example). The <...> entries are placeholders and are
# refused as is.
FLUXIQ_CLIENT_GATEWAY_ALLOWED_ORIGINS=chrome-extension://<chrome-extension-id>,chrome-extension://<edge-extension-id>,moz-extension://*

# --- Optional ------------------------------------------------------------

# Where the extension sends someone who has no account yet.
# FLUXIQ_SIGN_UP_URL=https://www.example.org/sign-up

# The name the extension shows for this server.
# FLUXIQ_INSTANCE_NAME=FluxIQ

# Open workspaces: how long an unused one stays loaded (milliseconds) and how
# many stay loaded at most. Unset keeps the built-in defaults.
# FLUXIQ_WORKSPACE_IDLE_MS=
# FLUXIQ_WORKSPACE_CACHE_MAX=

# Seconds a stopping server waits before it exits (default 30). Keep the
# compose file's stop_grace_period above it.
# FLUXIQ_DRAIN_SECONDS=30

# Account email: file (default; written to the outbox under /data), or none.
# FLUXIQ_EMAIL_SENDER=file

# Which panel screens and Settings tools this deployment shows: full (default),
# data-collection or task-automation. It only hides; permissions still apply.
# FLUXIQ_PANEL_PRESET=full
