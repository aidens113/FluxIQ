# FluxIQ Core, self-hosted profile: the operator's settings.
#
# Copy to deploy/env/self-hosted.env (git ignores it) and replace every value.
# This file holds no secret. Secrets are files mounted into the container
# (docs/operations/self-hosting.md, "Secrets"). Every value below is a
# placeholder on a reserved example domain. The gateway's <...> entries are
# refused by the client gateway, so the server does not become ready
# until they are replaced.
#
# deploy/compose/self-hosted.compose.yml fixes FLUXIQ_PROFILE=self-hosted,
# FLUXIQ_ROOT=/data and FLUXIQ_TRUST_PROXY=true itself.

# --- Required ------------------------------------------------------------

# The panel's public origin: https, no path. Sign-in, connect and the
# session cookie are bound to it, and the gateway URL is derived from it
# (wss://<host>/client).
FLUXIQ_PUBLIC_ORIGIN=https://fluxiq.example.org

# The same host name, for Caddy's site address and certificate.
FLUXIQ_SITE_ADDRESS=fluxiq.example.org

# Where the certificate authority sends expiry notices.
ACME_EMAIL=operator@example.org

# The browser-extension origins the gateway admits, comma separated. Exact
# origins only: chrome-extension://<id> for each Chrome and Edge build you
# use (their ids differ) and moz-extension://* for Firefox (ids are
# per-install). Wildcards other than moz-extension://*, paths and "null" are
# refused, and a gateway reachable from a network refuses to start without
# an entry. The <...> entries below are placeholders and are refused as is.
FLUXIQ_CLIENT_GATEWAY_ALLOWED_ORIGINS=chrome-extension://<chrome-extension-id>,chrome-extension://<edge-extension-id>,moz-extension://*

# --- Optional ------------------------------------------------------------

# The name the extension shows for this server.
# FLUXIQ_INSTANCE_NAME=FluxIQ

# Seconds a stopping server waits for builds and connected browsers to
# finish before it exits (default 30 off the local profile; 0 or off exits
# at once). Keep the compose file's stop_grace_period above it.
# FLUXIQ_DRAIN_SECONDS=30

# json (default off local) or text.
# FLUXIQ_LOG_FORMAT=json

# Account email: file (default; written to the outbox under /data), or none.
# FLUXIQ_EMAIL_SENDER=file

# Write each model call's request and answer to disk for debugging. Off
# unless set; the files hold page content, so leave it unset in production.
# FLUXIQ_LLM_STEP_LOG_DIR=
