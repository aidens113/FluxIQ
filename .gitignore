node_modules
.next
dist
coverage
playwright-report
test-results
.e2e-host
.turbo
.env
.env.*
!.env.example
.fluxiq
.fluxiq/
storage/*
!storage/.gitkeep
*.tsbuildinfo
logs
tmp
.tmp/

# Runtime data written by a service constructed without an explicit dataDir.
# Probe and memory-mode runs resolve these package-relative, so they appear
# under packages/*/ rather than in a run directory.
packages/*/recordings/
packages/*/indexes/
packages/*/storage/
packages/*/flows/
packages/*/pipeline/

# Dev-server logs written beside the app rather than into a run directory.
*-dev.stdout.log
*-dev.stderr.log
